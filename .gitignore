# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local data (clips, frames, calibration captures)
data/
*.mp4
*.mkv
*.webm

# Model artifacts (fetched by `make models`). The one exception is the recognizer's release
# descriptors: metadata only (URL at a pinned revision, size, SHA-256), committed
# so `make models` works on a fresh clone. The weights themselves never enter git.
models/*
!models/chessq/
models/chessq/*
!models/chessq/*.json
*.onnx

# Experiment scratch (run dirs, logs; see docs/reports/ for the results that matter)
scratch/

# Recorded ingress sessions (WP-H2) — the raw input of a run, replayable with
# `board-reader-edge feed --recording`. Large and machine-local; promote a
# session into data/ deliberately if it is worth keeping.
recordings/
client-logs/

# Browser-automation captures (playwright-mcp session snapshots)
.playwright-mcp/

# Claude Code local state — project skills under .claude/skills/ ARE committed
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Local recovery artifacts from the 2026-08-20 author-email history rewrite.
# The map translates any pre-rewrite SHA (an old note, a bookmark, a stale
# checkout) to its replacement; the bundle is the complete pre-rewrite history.
# Machine-local by design — the rewritten history is the only public one.
docs/commit-rewrite-map.tsv
docs/commit-rewrite-pre.bundle

# OS / editor
.DS_Store

# Frontend: node deps and the generated build. The viewer lives in packages/viewer/;
# `make ui` builds it into packages/viewer/build/. Generated — never committed.
node_modules/

# Secrets (RUNPOD_API_KEY etc) — repo is public
.env
.env.*
!.env.example
