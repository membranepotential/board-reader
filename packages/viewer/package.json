{
  "name": "board-reader-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "description": "board-reader viewer: the SvelteKit pages (live, /snapshot, /camera, /control) and the Node server that relays them to the inference node",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node server/main.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.1.1",
    "selfsigned": "5.5.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-node": "6.0.4",
    "@sveltejs/kit": "3.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.1.2",
    "@types/ws": "8.18.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  }
}
