#!/usr/bin/env bash
# Run a command with RUNPOD_API_KEY injected from the login keyring, and only
# for that command's lifetime:
#     tools/runpod/with-key runpodctl user
# Prefer this over exporting the key into a long-lived interactive shell.
set -euo pipefail

if [ $# -eq 0 ]; then
  echo "usage: with-key <command> [args...]" >&2
  exit 2
fi

key="$(secret-tool lookup service runpod key RUNPOD_API_KEY)" || key=""
if [ -z "$key" ]; then
  echo "runpod: no key in the keyring. Enrol it with:" >&2
  echo "  secret-tool store --label='RunPod API key' service runpod key RUNPOD_API_KEY" >&2
  exit 1
fi

exec env RUNPOD_API_KEY="$key" "$@"
