#!/usr/bin/env bash
# Stub ssh: logs the remote command, answers the few things rp reads back, and
# can be told to hang (RP_STUB_SSH_SLEEP) or fail (RP_STUB_SSH_FAIL) so the
# EXIT/INT/TERM trap can be exercised without a pod.
set -uo pipefail

remote="${*: -1}"
printf 'ssh %s\n' "$remote" >>"${RP_STUB_LOG:?RP_STUB_LOG unset}"

case "$remote" in
  *MemTotal*) echo "${RP_STUB_MEM_KB:-65536000}"; exit 0 ;;
  *rp_out_dir*) echo "/workspace/board-reader/scratch/runs/stub"; exit 0 ;;
esac

if [ -n "${RP_STUB_SSH_FAIL:-}" ] && printf '%s' "$remote" | grep -qF -- "$RP_STUB_SSH_FAIL"; then
  echo "stub ssh: failing on request" >&2
  exit "${RP_STUB_SSH_RC:-42}"
fi

if [ -n "${RP_STUB_SSH_SLEEP:-}" ]; then
  sleep "$RP_STUB_SSH_SLEEP"
fi
exit 0
