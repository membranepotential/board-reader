#!/usr/bin/env bash
# rp — rent a RunPod GPU, run the training queue on it, destroy it.
#
#   tools/train/cloud/rp sweep configs/run_g.yaml configs/run_h.yaml
#   tools/train/cloud/rp stage data/external/_cropcache/hr1.6_sp0.15_maskgray data/eval
#   tools/train/cloud/rp reap
#   tools/train/cloud/rp cost
#   tools/train/cloud/rp --dry-run sweep configs/smoke.yaml     # prints, spends nothing
#
# THE ONE RULE (.claude/skills/runpod/SKILL.md): a pod is created by a script
# that also destroys it. The EXIT/INT/TERM trap here is installed *before* the
# create call, and it reaps by pod id AND by pod name — so a Ctrl-C landing in
# the window between "RunPod allocated a pod" and "runpodctl printed its id"
# still tears the pod down. `pod delete`, never `pod stop`: a stopped pod keeps
# billing its disk and all durable state lives on the network volume anyway.
#
# The API key is read from the login keyring via tools/runpod/env.sh, exported
# into this process only, and NEVER written to a file or passed as an argv
# element. The pod is driven over plain SSH, so the key never leaves this host.
#
# runpodctl is v2.0.0-beta.1 (`runpodctl <resource> <action>`, `-o json` by
# default). Every flag emitted below was checked against `--help` of the
# installed binary; deviations from the plan are marked "DEVIATION:".
set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration — everything site-specific lives here.
# ---------------------------------------------------------------------------

# Datacenter. Network volumes are DC-locked and EU-SE-1 (the original pick)
# turned out not to support network volumes at all, so the volume — and
# therefore the GPU pool — lives in EU-RO-1.
DC="${BR_RP_DC:-EU-RO-1}"
VOLUME_NAME="${BR_RP_VOLUME:-board-reader}"

# Primary GPU: RTX 4090, 24 GB, $0.34/hr COMMUNITY (verified via `gpu list`).
# Fallback (explicit --fallback-pro6000 only, $1.69/hr — 5x the primary):
# RTX PRO 6000 Blackwell Server Edition, 96 GB, the VRAM escalation path.
# Both strings are exact `gpuId`s from `runpodctl gpu list`.
GPU_PRIMARY="${BR_RP_GPU:-NVIDIA GeForce RTX 4090}"
GPU_FALLBACK="${BR_RP_GPU_FALLBACK:-NVIDIA RTX PRO 6000 Blackwell Server Edition}"

# CUDA 12.8.1 base image: new enough for Blackwell (the fallback GPU), and it
# ships an sshd wired to the account's SSH keys. The venv setup.sh builds on
# top of it is what actually runs training — the image only supplies the driver
# stack. A lighter image for `stage` is only safe if it also ships sshd.
IMAGE="${BR_RP_IMAGE:-runpod/pytorch:1.0.3-cu1281-torch291-ubuntu2404}"
CPU_IMAGE="${BR_RP_CPU_IMAGE:-$IMAGE}"

# Volume layout. The network volume mounts at --volume-mount-path (RunPod's
# default is /workspace); everything durable hangs off it, including the venv,
# so a fresh pod re-uses the previous pod's install.
VOL="${BR_RP_VOL:-/workspace}"
VOL_REPO="$VOL/board-reader"      # repo checkout (code only; rsynced each sweep)
VOL_CACHE="$VOL/_cropcache"       # _cropcache/<variant>/ — the staged crop caches
VOL_DATA="$VOL/data"              # data/eval, data/uploads, data/images
VOL_VENV="$VOL/torchvenv"         # the torch venv, symlinked to <repo>/scratch/torchvenv

# ≥32 GB system RAM is non-negotiable: StyleData holds ~9 GB of JPEG bytes
# resident and torch 2.14's forkserver default turns every DataLoader worker
# into a full pickled copy (that OOM-killed a run_f launch).
# DEVIATION: `pod create --help` has no memory/RAM filter flag, so this is
# asserted over SSH after boot and the pod is deleted if it is short.
MIN_RAM_GIB="${BR_RP_MIN_RAM_GIB:-32}"
RAM_SLACK_GIB=2   # /proc/meminfo reports a bit under nominal (firmware reserve)

CONTAINER_DISK_GB="${BR_RP_CONTAINER_DISK_GB:-30}"
CPU_CONTAINER_DISK_GB="${BR_RP_CPU_CONTAINER_DISK_GB:-10}"
WAIT_TIMEOUT="${BR_RP_WAIT_TIMEOUT:-10m}"
MIN_BALANCE_USD="${BR_RP_MIN_BALANCE:-0.50}"

LOCAL_RUNS="scratch/runs"   # artifacts land in <repo>/scratch/runs/<name>/
ARTIFACTS=(best.pt model.onnx model.onnx.meta.json history.json events.jsonl
           val.log eval.txt pipe.log config.yaml)

# Code-only sync: data, caches and models live on the volume, not in the push.
RSYNC_EXCLUDES=(--exclude=.git --exclude=data --exclude=scratch --exclude=models
                --exclude=node_modules --exclude=worktrees --exclude=__pycache__
                --exclude='*.pyc' --exclude=.venv --exclude=.pytest_cache
                --exclude=.svelte-kit --exclude=dist --exclude=build)

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
RUNPODCTL="${RUNPODCTL:-runpodctl}"

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
DRY_RUN=false
FALLBACK_PRO6000=false
SECURE=false   # --secure: GPU pods on SECURE cloud (~2x price) — explicit only
POD_ID=""
POD_NAME=""
POD_HOST=""
POD_PORT=""
VOLUME_ID=""

# ---------------------------------------------------------------------------
# Plumbing
# ---------------------------------------------------------------------------
log()  { printf '[rp] %s\n' "$*" >&2; }
warn() { printf '[rp] WARNING: %s\n' "$*" >&2; }
die()  { printf '[rp] ERROR: %s\n' "$*" >&2; exit 1; }

quote_cmd() {
  local out="" a
  for a in "$@"; do out+=" $(printf '%q' "$a")"; done
  printf '%s' "${out# }"
}

# State-changing command: printed under --dry-run, executed otherwise.
run_state() {
  if $DRY_RUN; then
    printf '[dry-run] %s\n' "$(quote_cmd "$@")" >&2
    return 0
  fi
  "$@"
}

# Read-only command: always executed (it costs nothing and changes nothing).
run_ro() { "$@"; }

# First value found for <key> at any depth of the JSON on stdin. Tolerant of
# the exact response shape, which is undocumented for this beta and has already
# moved once between resources.
#
# `python3 -c`, not `python3 - <<HEREDOC`: a heredoc *is* stdin, so it would eat
# the JSON we are trying to parse.
_PY_JSON_PLUCK='
import json, sys
key = sys.argv[1]

def walk(o):
    if isinstance(o, dict):
        if o.get(key) not in (None, ""):
            yield o[key]
        for v in o.values():
            yield from walk(v)
    elif isinstance(o, list):
        for v in o:
            yield from walk(v)

try:
    doc = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for v in walk(doc):
    print(v)
    sys.exit(0)
sys.exit(1)
'
json_pluck() { python3 -c "$_PY_JSON_PLUCK" "$1"; }

# ---------------------------------------------------------------------------
# API key — keyring only, never a file, never an argv element
# ---------------------------------------------------------------------------
load_key() {
  if [ -n "${RUNPOD_API_KEY:-}" ]; then return 0; fi
  # shellcheck source=/dev/null
  if . "$ROOT/tools/runpod/env.sh"; then return 0; fi
  if $DRY_RUN; then
    warn "no API key in the keyring — dry-run continues, live calls are skipped"
    return 1
  fi
  die "no RunPod API key (see tools/runpod/env.sh)"
}

have_key() { [ -n "${RUNPOD_API_KEY:-}" ]; }

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------
check_balance() {
  local json bal
  json="$(run_ro "$RUNPODCTL" user -o json)" || die "runpodctl user failed"
  bal="$(printf '%s' "$json" | json_pluck clientBalance)" \
    || bal="$(printf '%s' "$json" | json_pluck currentBalance)" \
    || bal=""
  if [ -z "$bal" ]; then
    warn "could not read a balance out of 'runpodctl user' — continuing blind"
    return 0
  fi
  log "balance: \$$bal"
  python3 -c "import sys; sys.exit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)" \
    "$bal" "$MIN_BALANCE_USD" \
    || die "balance \$$bal is below the \$$MIN_BALANCE_USD floor — top up before renting"
}

check_no_pods() {
  local json ids
  json="$(run_ro "$RUNPODCTL" pod list --all -o json)" || die "runpodctl pod list failed"
  ids="$(printf '%s' "$json" | python3 -c '
import json, sys
try:
    doc = json.load(sys.stdin)
except Exception:
    doc = []
print("\n".join(p["id"] for p in doc if isinstance(p, dict) and p.get("id")))')"
  if [ -n "$ids" ]; then
    printf '%s\n' "$json" >&2
    die "pods are already standing (above). Run 'rp reap' first — every one of them is burning money."
  fi
  log "no pods standing"
}

resolve_volume() {
  local json
  json="$(run_ro "$RUNPODCTL" network-volume list -o json)" \
    || die "runpodctl network-volume list failed"
  VOLUME_ID="$(printf '%s' "$json" | python3 -c '
import json, sys
name, dc = sys.argv[1], sys.argv[2]
try:
    doc = json.load(sys.stdin)
except Exception:
    doc = []
for v in doc if isinstance(doc, list) else []:
    if v.get("name") == name and v.get("dataCenterId") == dc:
        print(v["id"])
        break
' "$VOLUME_NAME" "$DC")"
  [ -n "$VOLUME_ID" ] \
    || die "no network volume named '$VOLUME_NAME' in $DC — create it once with:
  runpodctl network-volume create --name $VOLUME_NAME --size 20 --data-center-id $DC"
  log "network volume: $VOLUME_ID ($VOLUME_NAME @ $DC)"
}

preflight() {
  load_key || true
  if ! have_key; then
    log "dry-run without a key: skipping balance / pod-list / volume preflight"
    VOLUME_ID="DRYRUN-VOLUME"
    return 0
  fi
  check_balance
  check_no_pods
  resolve_volume
}

# ---------------------------------------------------------------------------
# Pod lifecycle — trap first, create second
# ---------------------------------------------------------------------------

# Deletes everything this invocation is responsible for. Idempotent, tolerant
# of an already-deleted pod, and it never fails the script: it runs from the
# EXIT trap, whose job is to preserve the real exit code.
reap_owned() {
  local id
  if [ -n "$POD_ID" ]; then
    log "deleting pod $POD_ID"
    # stdout only: run_state's --dry-run line and any real error go to stderr,
    # and swallowing those is how a failed teardown becomes an invisible bill.
    run_state "$RUNPODCTL" pod delete "$POD_ID" >/dev/null \
      || warn "pod delete $POD_ID returned nonzero (already gone?) — verify with 'rp reap'"
  fi
  # Backstop: anything wearing this invocation's name, including a pod that was
  # allocated before runpodctl told us its id (Ctrl-C during --wait), and a pod
  # kept alive by a --wait-timeout whose id we failed to parse.
  if [ -n "$POD_NAME" ] && have_key && ! $DRY_RUN; then
    while read -r id; do
      [ -n "$id" ] || continue
      if [ "$id" = "$POD_ID" ]; then continue; fi
      warn "orphan pod $id matched name $POD_NAME — deleting"
      "$RUNPODCTL" pod delete "$id" >/dev/null 2>&1 || true
    done < <("$RUNPODCTL" pod list --all --name "$POD_NAME" -o json 2>/dev/null | python3 -c '
import json, sys
try:
    doc = json.load(sys.stdin)
except Exception:
    doc = []
for p in doc if isinstance(doc, list) else []:
    if p.get("id"):
        print(p["id"])' || true)
  elif [ -n "$POD_NAME" ] && $DRY_RUN; then
    printf '[dry-run] %s\n' "$(quote_cmd "$RUNPODCTL" pod list --all --name "$POD_NAME")" >&2
  fi
}

on_exit() {
  local rc=$?
  trap - EXIT INT TERM
  # `|| true`: set -e is still armed inside the trap, and a nonzero teardown
  # must not overwrite the status the caller actually needs to see.
  reap_owned || true
  exit "$rc"
}

# INT/TERM re-raise as an exit, which fires on_exit exactly once. 128+signo is
# the conventional status, and on_exit preserves it.
arm_trap() {
  POD_NAME="br-$1-$(date -u +%Y%m%d-%H%M%S)-$$"
  trap on_exit EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  log "teardown armed for pod name $POD_NAME"
}

# create_pod <gpu-id|"">  — "" means a CPU pod.
# Sets POD_ID even when create *fails*, because a --wait-timeout keeps the pod
# and carries its id in the error text. Returns the create exit status.
create_pod() {
  local gpu="$1" out rc=0
  out="$(mktemp)"

  # CPU pods reject container disks over 20 GB ("Container Disk must be less
  # than or equal to 20"); staging writes to the volume anyway, so 10 is plenty.
  local disk="$CONTAINER_DISK_GB"
  [ -n "$gpu" ] || disk="$CPU_CONTAINER_DISK_GB"

  local args=(pod create
    --name "$POD_NAME"
    --data-center-ids "$DC"
    --network-volume-id "$VOLUME_ID"
    --volume-mount-path "$VOL"
    --container-disk-in-gb "$disk"
    --wait --wait-timeout "$WAIT_TIMEOUT")

  if [ -n "$gpu" ]; then
    # COMMUNITY is ~2x cheaper than the SECURE default; --public-ip is what
    # makes port 22 publicly mapped, which --wait (and our SSH) needs there.
    # SECURE (explicit --secure only) maps port 22 publicly without the flag,
    # which is documented as community-only.
    # --ports 22/tcp is load-bearing on every branch: a CLI-created pod
    # publishes NO ports by default (live finding, 08-28 — `pod get` said
    # "pod does not publish 22/tcp" while --wait hung against it), and --wait
    # needs a publicly mapped 22 to ever return.
    if $SECURE; then
      warn "SECURE cloud requested explicitly (~2x the community price)"
      args+=(--image "$IMAGE" --cloud-type SECURE --gpu-id "$gpu" --gpu-count 1 --ports 22/tcp)
    else
      args+=(--image "$IMAGE" --cloud-type COMMUNITY --gpu-id "$gpu" --gpu-count 1 --public-ip --ports 22/tcp)
    fi
  else
    # DEVIATION: CPU pods are not offered on community cloud, and --public-ip
    # is documented as "community cloud only" — so the staging pod runs on the
    # SECURE default, where port 22 is publicly mapped without the flag.
    args+=(--image "$CPU_IMAGE" --compute-type cpu --ports 22/tcp)
  fi

  log "creating pod (${gpu:-cpu}) — this is the moment money starts"
  if $DRY_RUN; then
    printf '[dry-run] %s\n' "$(quote_cmd "$RUNPODCTL" "${args[@]}")" >&2
    POD_ID="DRYRUN-POD"
    POD_HOST="dryrun.invalid"
    POD_PORT="22"
    rm -f "$out"
    return 0
  fi

  "$RUNPODCTL" "${args[@]}" >"$out" 2>&1 || rc=$?
  cat "$out" >&2
  # --wait prefixes human-readable "waiting for ssh on pod <id>" lines to the
  # JSON (live finding, 08-28: json.load on the mixed output failed, POD_ID
  # came up empty, and the trap reaped a healthy pod by name). Parse the JSON
  # from its first line, and take the id from the progress text as a backup.
  POD_ID="$(sed -n '/^{/,$p' "$out" | json_pluck id || true)"
  if [ -z "$POD_ID" ]; then
    POD_ID="$(grep -oE '\bon pod [a-z0-9]{6,}' "$out" | head -n1 | awk '{print $3}' || true)"
  fi
  if [ -z "$POD_ID" ]; then
    # --wait-timeout keeps the pod and puts the id in a non-JSON error line.
    # Best effort: the exact wording is undocumented, which is precisely why
    # reap_owned's name-based sweep — not this regex — is the actual guarantee.
    POD_ID="$(grep -oiE 'pod[ _-]?id[^a-zA-Z0-9]{1,4}[a-zA-Z0-9][a-zA-Z0-9_-]{5,}' "$out" \
              | head -n1 | grep -oE '[a-zA-Z0-9][a-zA-Z0-9_-]{5,}$' || true)"
    if [ -n "$POD_ID" ]; then
      warn "recovered pod id $POD_ID from a non-JSON response — it will be reaped"
    fi
  fi
  rm -f "$out"
  return "$rc"
}

# SSH endpoint. `pod get` is authoritative; `ssh info` is the documented
# fallback ("show ssh info for a pod (command + key)"), whose JSON shape is
# undocumented, so both are parsed defensively.
resolve_ssh() {
  if $DRY_RUN; then POD_HOST="dryrun.invalid"; POD_PORT="22"; return 0; fi
  # The endpoint can lag the pod's RUNNING state (port mapping publishes late),
  # so retry before concluding the JSON shape is wrong — and when giving up,
  # keep the raw responses: they are the only way to fix parse_endpoint.
  local ep="" try dbg="$ROOT/scratch/rp_debug-$POD_ID"
  mkdir -p "$ROOT/scratch"
  for try in 1 2 3 4 5 6 7 8; do
    run_ro "$RUNPODCTL" pod get "$POD_ID" -o json >"$dbg-podget.json" 2>&1 || true
    ep="$(parse_endpoint <"$dbg-podget.json" || true)"
    if [ -z "$ep" ]; then
      run_ro "$RUNPODCTL" ssh info "$POD_ID" -o json >"$dbg-sshinfo.json" 2>&1 || true
      ep="$(parse_endpoint <"$dbg-sshinfo.json" || true)"
    fi
    [ -n "$ep" ] && break
    log "no SSH endpoint yet for $POD_ID (try $try/8) — raw responses in $dbg-*.json"
    sleep 15
  done
  [ -n "$ep" ] || die "could not resolve an SSH endpoint for $POD_ID after 8 tries — \
inspect $dbg-*.json, fix parse_endpoint (the pod is being deleted)"
  rm -f "$dbg-podget.json" "$dbg-sshinfo.json"
  POD_HOST="${ep% *}"
  POD_PORT="${ep#* }"
  log "ssh root@$POD_HOST -p $POD_PORT"
}

# Reads a pod-ish JSON document on stdin, prints "<host> <port>" for port 22.
_PY_PARSE_ENDPOINT='
import json, re, sys

try:
    doc = json.load(sys.stdin)
except Exception:
    sys.exit(1)

host = port = None

def walk(o):
    global host, port
    if isinstance(o, dict):
        for k, v in o.items():
            kl = k.lower()
            if isinstance(v, str) and not host and kl in ("publicip", "ip", "host", "hostname"):
                host = v
            # {"portMappings": {"22": 41234}} and friends
            if kl in ("portmappings", "ports", "portmapping") and isinstance(v, dict):
                for pk, pv in v.items():
                    if str(pk).startswith("22") and not port:
                        port = int(pv)
            # [{"privatePort": 22, "publicPort": 41234}]
            if isinstance(v, list):
                for item in v:
                    if isinstance(item, dict):
                        priv = item.get("privatePort") or item.get("private_port")
                        pub = item.get("publicPort") or item.get("public_port")
                        if priv == 22 and pub and not port:
                            port = int(pub)
            # "ssh root@1.2.3.4 -p 41234 -i ~/.ssh/id_ed25519"
            if isinstance(v, str) and v.strip().startswith("ssh "):
                m = re.search(r"@([\w.\-]+)", v)
                p = re.search(r"-p\s+(\d+)", v)
                if m and not host:
                    host = m.group(1)
                if p and not port:
                    port = int(p.group(1))
            walk(v)
    elif isinstance(o, list):
        for v in o:
            walk(v)

walk(doc)
if not host or not port:
    sys.exit(1)
print(host, port)
'
parse_endpoint() { python3 -c "$_PY_PARSE_ENDPOINT"; }

ssh_opts() {
  local opts=(-o StrictHostKeyChecking=accept-new
              -o "UserKnownHostsFile=$ROOT/scratch/rp_known_hosts"
              -o ConnectTimeout=20 -o ServerAliveInterval=30 -o ServerAliveCountMax=10
              -o LogLevel=ERROR)
  if [ -n "${BR_RP_SSH_KEY:-}" ]; then opts+=(-i "$BR_RP_SSH_KEY"); fi
  printf '%s\n' "${opts[@]}"
}

pod_ssh() {
  local opts=()
  mapfile -t opts < <(ssh_opts)
  run_state ssh "${opts[@]}" -p "$POD_PORT" "root@$POD_HOST" "$@"
}

# `-e` string for rsync/scp, individually quoted so paths with spaces survive.
ssh_e() {
  local s="ssh" o opts=()
  mapfile -t opts < <(ssh_opts)
  for o in "${opts[@]}"; do s+=" $(printf '%q' "$o")"; done
  printf '%s -p %s' "$s" "$POD_PORT"
}

assert_ram() {
  if $DRY_RUN; then log "dry-run: skipping the ${MIN_RAM_GIB} GiB RAM assertion"; return 0; fi
  local kb gib
  kb="$(pod_ssh "awk '/^MemTotal:/{print \$2}' /proc/meminfo" | tr -d '[:space:]')"
  [ -n "$kb" ] || die "could not read /proc/meminfo on the pod"
  gib=$(( kb / 1024 / 1024 ))
  log "pod RAM: ${gib} GiB"
  if [ "$gib" -lt $((MIN_RAM_GIB - RAM_SLACK_GIB)) ]; then
    die "pod has ${gib} GiB RAM, need >= ${MIN_RAM_GIB} GiB (StyleData holds ~9 GB resident and \
forkserver workers copy it) — the pod is being deleted"
  fi
}

ensure_rsync() {
  pod_ssh 'command -v rsync >/dev/null || (apt-get update -qq && apt-get install -y -qq rsync)'
}

sync_repo() {
  log "syncing the repo (code only) to $VOL_REPO"
  pod_ssh "mkdir -p $(printf '%q' "$VOL_REPO")"
  # --delete (not --delete-excluded): stale code goes, but the excluded paths on
  # the pod — data/, scratch/ and the symlinks link_data plants there — survive.
  # -rlptDz, not -az: -a implies -og (owner/group), and chown on the network
  # volume is Operation-not-permitted — rsync then exits 23 and set -e turns a
  # cosmetic attribute miss into a dead pod (live finding, 08-28).
  run_state rsync -rlptDz --delete "${RSYNC_EXCLUDES[@]}" \
    -e "$(ssh_e)" "$ROOT/" "root@$POD_HOST:$VOL_REPO/"
}

# Wire the volume's data into the paths the harness hard-codes off the repo
# root (cropcache.CACHE_ROOT = <repo>/data/external/_cropcache, evaluate.py's
# data/eval + data/uploads), and the venv into <repo>/scratch/torchvenv so
# _env.sh finds it with no PY override.
link_data() {
  log "linking volume data into the checkout"
  pod_ssh "set -e
    mkdir -p $VOL_CACHE $VOL_DATA $VOL_REPO/data/external $VOL_REPO/scratch
    ln -sfn $VOL_CACHE $VOL_REPO/data/external/_cropcache
    for d in eval uploads images; do
      mkdir -p $VOL_DATA/\$d
      ln -sfn $VOL_DATA/\$d $VOL_REPO/data/\$d
    done
    # Raw styles staged under data/external/ (e.g. chesscog_transfer, which
    # evaluate.py reads as IMAGES via discover_styles, not from the crop cache)
    # each get a symlink beside the _cropcache one.
    if [ -d $VOL_DATA/external ]; then
      for s in $VOL_DATA/external/*/; do
        [ -d \"\$s\" ] || continue
        ln -sfn \"\${s%/}\" $VOL_REPO/data/external/\$(basename \"\$s\")
      done
    fi
    ln -sfn $VOL_VENV $VOL_REPO/scratch/torchvenv"
}

run_setup() {
  log "running setup.sh on the pod (venv on the volume; survives pod deletion)"
  pod_ssh "BR_VENV=$(printf '%q' "$VOL_VENV") BR_REPO=$(printf '%q' "$VOL_REPO") \
           bash $(printf '%q' "$VOL_REPO/tools/train/cloud/setup.sh")"
}

# ---------------------------------------------------------------------------
# sweep
# ---------------------------------------------------------------------------
config_run_name() {
  local base
  base="$(basename "$1")"
  printf '%s' "${base%.yaml}"
}

pull_artifacts() {
  local name="$1" remote_dir="$2" f
  local dest="$ROOT/$LOCAL_RUNS/$name"
  run_state mkdir -p "$dest"
  log "pulling artifacts -> $LOCAL_RUNS/$name/"
  for f in "${ARTIFACTS[@]}"; do
    run_state rsync -rlptD --ignore-missing-args -e "$(ssh_e)" \
      "root@$POD_HOST:$remote_dir/$f" "$dest/" \
      || warn "no $f in $remote_dir (stage may have failed — check pipe.log)"
  done
}

cmd_sweep() {
  [ $# -gt 0 ] || die "usage: rp sweep <config.yaml>..."
  local cfg name remote_out abs rel
  local -a configs=()
  # remote_run.sh resolves configs against tools/train (its cwd on the pod), so
  # normalize whatever shape the caller used to that — a repo-root-relative path
  # would pass this check locally and then 404 on the pod, after setup is paid for.
  for cfg in "$@"; do
    if [ -f "$cfg" ]; then abs="$(realpath "$cfg")"
    elif [ -f "$ROOT/tools/train/$cfg" ]; then abs="$(realpath "$ROOT/tools/train/$cfg")"
    else die "no such config: $cfg"
    fi
    rel="${abs#"$ROOT/tools/train/"}"
    [ "$rel" != "$abs" ] || die "config must live under tools/train/: $cfg"
    configs+=("$rel")
  done

  preflight
  arm_trap sweep

  local gpu="$GPU_PRIMARY"
  if ! create_pod "$gpu"; then
    if $FALLBACK_PRO6000; then
      warn "$GPU_PRIMARY create failed — falling back to $GPU_FALLBACK (5x the price, explicitly requested)"
      reap_owned          # whatever the failed attempt left behind
      POD_ID=""
      gpu="$GPU_FALLBACK"
      create_pod "$gpu" || die "fallback create on $GPU_FALLBACK also failed"
    else
      die "$GPU_PRIMARY create failed in $DC (stock?). Re-run with --fallback-pro6000 to \
accept $GPU_FALLBACK instead — it is ~5x the price, so this is never automatic."
    fi
  fi
  log "pod $POD_ID up on $gpu"
  provision_and_run "${configs[@]}"
}

# Everything after a pod exists: provision it, run the config queue, pull
# artifacts. Shared by sweep (fresh pod) and adopt (pre-existing pod). The
# caller must have armed the trap and set POD_ID.
provision_and_run() {
  local -a configs=("$@")
  local cfg name remote_out

  resolve_ssh
  assert_ram
  ensure_rsync
  sync_repo
  link_data
  run_setup

  local rc failed=0
  for cfg in "${configs[@]}"; do
    name="$(config_run_name "$cfg")"
    log "=== run $name ==="
    # setsid: the pipeline gets its own process group, so an abort can kill the
    # GROUP (kill -9 -PGID) rather than SIGSTOP-ing a CUDA process, which turns
    # it into a zombie-spinner. `pod delete` is the terminal kill regardless.
    rc=0
    pod_ssh "cd $(printf '%q' "$VOL_REPO/tools/train") && \
             setsid bash cloud/remote_run.sh $(printf '%q' "$cfg") $(printf '%q' "$name")" \
      || rc=$?
    remote_out="$(pod_ssh "cat $(printf '%q' "$VOL_REPO/scratch/rp_out_dir.$name") 2>/dev/null" \
                  | tr -d '[:space:]')" || remote_out=""
    [ -n "$remote_out" ] || remote_out="$VOL_REPO/$LOCAL_RUNS/$name"
    # Pull artifacts even on failure: val.log / events.jsonl / pipe.log are the
    # only evidence of *why* it died, and they die with the pod.
    pull_artifacts "$name" "$remote_out"
    if [ "$rc" -ne 0 ]; then
      warn "run $name failed (exit $rc) — logs are in $LOCAL_RUNS/$name/"
      failed=$((failed + 1))
    fi
  done

  if [ "$failed" -gt 0 ]; then
    # The queue is not abandoned on the first failure: the pod is already paid
    # for, later configs are independent, and a failing run aborts fast anyway.
    die "$failed of ${#configs[@]} run(s) failed — the trap is deleting pod $POD_ID"
  fi
  log "queue done — the trap now deletes pod $POD_ID"
}

# ---------------------------------------------------------------------------
# adopt — take over a pod that already exists (an orphan from a killed runner)
# and run the queue on it. The trap owns it from here: it WILL be deleted.
# ---------------------------------------------------------------------------
cmd_adopt() {
  local pod_id="${1:-}"; shift || true
  [ -n "$pod_id" ] && [ $# -gt 0 ] || die "usage: rp adopt <pod-id> <config.yaml>..."
  local cfg abs rel
  local -a configs=()
  for cfg in "$@"; do
    if [ -f "$cfg" ]; then abs="$(realpath "$cfg")"
    elif [ -f "$ROOT/tools/train/$cfg" ]; then abs="$(realpath "$ROOT/tools/train/$cfg")"
    else die "no such config: $cfg"
    fi
    rel="${abs#"$ROOT/tools/train/"}"
    [ "$rel" != "$abs" ] || die "config must live under tools/train/: $cfg"
    configs+=("$rel")
  done

  load_key || true
  have_key || die "adopt needs the API key"
  check_balance
  arm_trap adopt
  POD_ID="$pod_id"
  log "adopted pod $POD_ID — the trap now owns and will delete it"
  provision_and_run "${configs[@]}"
}

# ---------------------------------------------------------------------------
# stage
# ---------------------------------------------------------------------------
# Local repo path -> volume path, so the volume ends up laid out as
#   _cropcache/<variant>/ · data/{eval,uploads,images} · board-reader/<code>
remote_dest_for() {
  local abs rel
  abs="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
  case "$abs" in
    "$ROOT"/*) rel="${abs#"$ROOT"/}" ;;
    *) die "stage only takes paths inside the repo: $1" ;;
  esac
  case "$rel" in
    data/external/_cropcache/*) printf '%s/%s' "$VOL_CACHE" "${rel#data/external/_cropcache/}" ;;
    data/external/_cropcache)   printf '%s' "$VOL_CACHE" ;;
    data/*)                     printf '%s/%s' "$VOL_DATA" "${rel#data/}" ;;
    *)                          printf '%s/%s' "$VOL_REPO" "$rel" ;;
  esac
}

cmd_stage() {
  [ $# -gt 0 ] || die "usage: rp stage <path-inside-the-repo>..."
  local src dest parent
  for src in "$@"; do
    [ -e "$src" ] || die "no such path: $src"
  done

  preflight
  arm_trap stage

  create_pod "" || die "CPU pod create failed"
  log "cpu pod $POD_ID up"
  resolve_ssh
  ensure_rsync

  for src in "$@"; do
    dest="$(remote_dest_for "$src")"
    parent="$(dirname "$dest")"
    log "staging $src -> $dest"
    pod_ssh "mkdir -p $(printf '%q' "$parent")"
    # Trailing slash on a directory source copies its *contents* into dest,
    # which is what makes _cropcache/<variant> land as <variant>.
    if [ -d "$src" ]; then
      run_state rsync -rlptD --partial --info=stats1 -e "$(ssh_e)" \
        "${src%/}/" "root@$POD_HOST:$dest/"
    else
      run_state rsync -rlptD --partial --info=stats1 -e "$(ssh_e)" \
        "$src" "root@$POD_HOST:$dest"
    fi
  done

  log "staging done — the trap now deletes pod $POD_ID"
}

# ---------------------------------------------------------------------------
# reap / cost
# ---------------------------------------------------------------------------
cmd_reap() {
  load_key || true
  have_key || die "reap needs the API key"
  local json ids id
  json="$(run_ro "$RUNPODCTL" pod list --all -o json)" || die "runpodctl pod list failed"
  ids="$(printf '%s' "$json" | python3 -c '
import json, sys
try:
    doc = json.load(sys.stdin)
except Exception:
    doc = []
for p in doc if isinstance(doc, list) else []:
    if p.get("id"):
        print(p["id"], p.get("name", "?"), p.get("desiredStatus", "?"), p.get("runtimeStatus", "?"))')"
  if [ -z "$ids" ]; then
    log "nothing standing"
    return 0
  fi
  printf '%s\n' "$ids" >&2
  while read -r id _; do
    [ -n "$id" ] || continue
    log "deleting $id"
    run_state "$RUNPODCTL" pod delete "$id" >/dev/null \
      || warn "delete $id returned nonzero (already gone?)"
  done <<<"$ids"
  log "reaped $(printf '%s\n' "$ids" | wc -l) pod(s)"
}

cmd_cost() {
  load_key || true
  have_key || die "cost needs the API key"
  # shellcheck disable=SC2016  # the $ are literal dollar signs, not expansions
  run_ro "$RUNPODCTL" user -o json | python3 -c '
import json, sys
u = json.load(sys.stdin)
bal = u.get("clientBalance", 0.0)
rate = u.get("currentSpendPerHr", 0.0)
limit = u.get("spendLimit", 0.0)
print(f"balance      ${bal:.4f}")
print(f"burn rate    ${rate:.4f}/hr  (nonzero with no pod = the network volume)")
print(f"spend limit  ${limit}")
'
  # DEVIATION: bare `runpodctl billing` is a parent command that only prints
  # help; the history lives under `billing pods` / `billing network-volume`.
  echo "--- pods"
  run_ro "$RUNPODCTL" billing pods -o json || warn "billing pods failed"
  echo "--- network volumes"
  run_ro "$RUNPODCTL" billing network-volume -o json || warn "billing network-volume failed"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
usage() {
  cat >&2 <<'USAGE'
usage: rp [--dry-run] [--fallback-pro6000] [--secure] <command> [args]

  sweep <config.yaml>...   one pod for the whole queue: create -> setup ->
                           train/export/evaluate each config -> pull artifacts
                           -> delete. The pod is deleted on success, error and
                           Ctrl-C alike.
  stage <path>...          CPU pod with the volume attached; rsync repo-relative
                           paths onto the volume; delete.
  reap                     delete every pod standing on the account.
  cost                     balance + pod and network-volume billing history.

  --dry-run                print every state-changing runpodctl/ssh/rsync
                           command instead of running it. Read-only calls still
                           run (they cost nothing).
  --fallback-pro6000       if the RTX 4090 cannot be created, accept an
                           RTX PRO 6000 (96 GB) instead. ~5x the price; never
                           automatic.
USAGE
  exit 2
}

main() {
  local -a rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=true ;;
      --fallback-pro6000) FALLBACK_PRO6000=true ;;
      --secure) SECURE=true ;;
      -h|--help) usage ;;
      --) shift; rest+=("$@"); break ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
  [ ${#rest[@]} -gt 0 ] || usage

  command -v python3 >/dev/null || die "python3 is required (JSON parsing)"

  local cmd="${rest[0]}"
  local -a args=("${rest[@]:1}")
  case "$cmd" in
    sweep) cmd_sweep ${args[@]+"${args[@]}"} ;;
    adopt) cmd_adopt ${args[@]+"${args[@]}"} ;;
    stage) cmd_stage ${args[@]+"${args[@]}"} ;;
    reap)  cmd_reap ;;
    cost)  cmd_cost ;;
    *) usage ;;
  esac
}

main "$@"
